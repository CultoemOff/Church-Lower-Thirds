#!/bin/bash
# Stops the running server (the installed version) before its files are replaced.
LABEL=com.cultoemoff.churchlowerthirds
user=$(/usr/bin/stat -f%Su /dev/console)
if [ -n "$user" ] && [ "$user" != root ] && [ "$user" != loginwindow ]; then
  /bin/launchctl bootout "gui/$(id -u "$user")/$LABEL" 2>/dev/null || true
fi
/usr/bin/pkill -f "Church Lower Thirds.app/Contents/Resources/app/dist/server/index.js" 2>/dev/null || true
exit 0
