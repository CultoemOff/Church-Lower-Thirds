<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Church Lower Thirds</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <license file="license.html" mime-type="text/html"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check>
    <allowed-os-versions>
      <!-- Node.js 24, bundled with the app, needs macOS 13.5 or later. -->
      <os-version min="13.5"/>
    </allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="default">
      <line choice="com.cultoemoff.churchlowerthirds"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.cultoemoff.churchlowerthirds" visible="false">
    <pkg-ref id="com.cultoemoff.churchlowerthirds"/>
  </choice>
  <pkg-ref id="com.cultoemoff.churchlowerthirds" version="@VERSION@" onConclusion="none">church-lower-thirds-app.pkg</pkg-ref>
</installer-gui-script>
