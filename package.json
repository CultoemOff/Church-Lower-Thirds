{
  "name": "lower-third-web",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Lower Third Web — by Culto em Off | Lower thirds e overlays para OBS Studio",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "format": "prettier --write src test .github",
    "format:check": "prettier --check src test .github",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint src/web"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
