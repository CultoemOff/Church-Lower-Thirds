{
  "name": "church-lower-thirds",
  "version": "0.1.0-beta.9",
  "private": true,
  "description": "Church Lower Thirds by Culto em Off | Free lower thirds & overlays for church live streams in OBS Studio",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "format": "prettier --write src test scripts .github",
    "format:check": "prettier --check src test scripts .github",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint src/web",
    "i18n": "node scripts/build-i18n.mjs && prettier --write src/web/js/i18n"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
